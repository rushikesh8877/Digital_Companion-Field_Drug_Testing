<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Minimal window theme for the single Compose activity — the app's real
      visual styling comes from the Material3 MaterialTheme{} wrapper in
      app.ui.MainScreen.DemoApp. This just needs to be a valid AppCompat
      theme so the window decorates correctly before Compose draws.
    -->
    <style name="Theme.DigitalCompanion" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#3F51B5</item>
        <item name="colorPrimaryDark">#303F9F</item>
        <item name="colorAccent">#3F51B5</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
